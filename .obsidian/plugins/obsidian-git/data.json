{
  "commitMessage": "vault(auto): {{date}} — Smee sync",
  "commitDateFormat": "YYYY-MM-DD HH:mm",
  "autoSaveInterval": 5,
  "autoPushInterval": 0,
  "autoPullInterval": 15,
  "pullOptions": ["default", "hard", "soft", "index"],
  "pushOptions": ["force", "force-with-lease", "force-with-lease-oss", "no-force", "force-with-lease-if-updates"],
  "autosaveIntervalSeconds": 300,
  "differentIntervalForSaveAndPush": false,
  "autoPullOnBoot": true,
  "autoPushOnChatComplete": false,
  "autoPushOnMarkdownChange": true,
  "autoPushOnRegularChange": true,
  "commitMessageOfMerges": "vault(merge): {{current}} → {{destination}}",
  "ignore": [
    ".obsidian/plugins/",
    ".obsidian/workspace.json",
    ".obsidian/workspaces.json",
    ".smart-env/",
    "copilot/copilot-conversations/"
  ]
}
