{
  "command_timeout": 5,
  "templates_folder": "_templates",
  "templates_pairs": [["", ""]],
  "trigger_on_file_creation": true,
  "auto_jump_to_cursor": true,
  "enable_system_commands": false,
  "shell_path": "",
  "user_scripts_folder": "_scripts",
  "enable_folder_templates": true,
  "folder_templates": [
    {
      "folder": "01-Inbox",
      "template": "_templates/quickadd-atomic-note.md"
    },
    {
      "folder": "02-Daily",
      "template": "_templates/daily-note.md"
    },
    {
      "folder": "10-Projects",
      "template": "_templates/project-kickoff.md"
    },
    {
      "folder": "40-Knowledge-Synthesis/Insights",
      "template": "_templates/atomic-note.md"
    },
    {
      "folder": "40-Knowledge-Synthesis/Concepts",
      "template": "_templates/atomic-note.md"
    },
    {
      "folder": "40-Knowledge-Synthesis/Frameworks",
      "template": "_templates/atomic-note.md"
    },
    {
      "folder": "50-Reviews",
      "template": "_templates/quickadd-weekly-review.md"
    },
    {
      "folder": "30-Resources",
      "template": "_templates/literature-note.md"
    }
  ],
  "enable_file_templates": false,
  "file_templates": [{"regex": ".*", "template": ""}],
  "syntax_highlighting": true,
  "syntax_highlighting_mobile": false,
  "enabled_templates_hotkeys": [
    "_templates/atomic-note.md",
    "_templates/daily-note.md",
    "_templates/project-kickoff.md",
    "_templates/literature-note.md",
    "_templates/quickadd-weekly-review.md"
  ],
  "startup_templates": ["_templates/daily-note.md"],
  "intellisense_render": 1,
  "trigger_on_file_change": false,
  "commands_folder": "_scripts",
  "error_message": "",
  "status_messages_display_time": 7000,
  "status_messages_enabled": true,
  "global_templates": [],
  "custom_triggers": {
    "date": "{{date}}",
    "time": "{{time}}",
    "datetime": "{{date}} {{time}}",
    "tomorrow": "{{date+1d}}",
    "yesterday": "{{date-1d}}",
    "week": "{{date:GGGG-[W]WW}}"
  }
}